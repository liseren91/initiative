# Initiative — env template for running the app
# Copy to backend/.env for local run, or set these in Railway/Neon/etc.

# ============== REQUIRED ==============

# JWT signing key (generate a random string for production)
SECRET_KEY=change-me

# PostgreSQL: superuser (migrations, role creation)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# PostgreSQL: app_user role (RLS-enforced; migration creates this role)
DATABASE_URL_APP=postgresql+asyncpg://app_user:app_user_password@host:5432/dbname

# PostgreSQL: app_admin role (BYPASSRLS; migration creates this role)
DATABASE_URL_ADMIN=postgresql+asyncpg://app_admin:app_admin_password@host:5432/dbname

# Public URL of the app (for OIDC callbacks, links in emails)
APP_URL=http://localhost:5173

# ============== OPTIONAL ==============

# First user to register becomes admin; or bootstrap one:
# FIRST_SUPERUSER_EMAIL=admin@example.com
# FIRST_SUPERUSER_PASSWORD=changeme
# FIRST_SUPERUSER_FULL_NAME=Admin User

# Restrict guild creation to platform admin
# DISABLE_GUILD_CREATION=false

# Allow sign-up without invite link
# ENABLE_PUBLIC_REGISTRATION=true

# When behind nginx/load balancer
# BEHIND_PROXY=false
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# OIDC (optional)
# OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=
# OIDC_SCOPES=openid,profile,email,offline_access

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=

# Full list: backend/.env.example
